# Environment and local secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12

# Runtime data
data/
# `data/` above is for runtime payloads; the research data-source package is code.
!apps/research/src/quantx_research/data/
!apps/research/src/quantx_research/data/**
# Infrastructure market-data adapters are source code, not runtime payloads.
!packages/infrastructure/src/quantx_infrastructure/core/data/
!packages/infrastructure/src/quantx_infrastructure/core/data/**
# The QMT Agent XTData adapter is source code as well.
!apps/qmt-agent/src/quantx_qmt_agent/miniqmt/data/
!apps/qmt-agent/src/quantx_qmt_agent/miniqmt/data/**
logs/
*.log
*.pid
*.db
*.sqlite
*.sqlite3

