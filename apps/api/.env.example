# QuantX API 环境变量配置示例
# 复制此文件为 .env 并根据需要修改配置

# =============================================================================
# 服务器配置
# =============================================================================
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development
TIMEZONE=Asia/Shanghai
TRADING_TIMEZONE=Asia/Shanghai
TZ=Asia/Shanghai

# =============================================================================
# CORS 配置
# =============================================================================
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://localhost:3000,http://localhost:5173

# =============================================================================
# 数据库配置
# =============================================================================
# 关系型数据库（SQLite/PostgreSQL）
DATABASE_URL=sqlite:///./quantx.db
DATABASE_ECHO=False

# InfluxDB 3.x 时间序列数据库配置
# 如果不配置，系统将使用内存存储时间序列数据
INFLUXDB_HOST=https://your-influxdb-host.com
INFLUXDB_TOKEN=your-influxdb-token
INFLUXDB_DATABASE=quantx_market_data
DATABASE_ECHO=False

# =============================================================================
# 实时数据配置
# =============================================================================
REALTIME_UPDATE_INTERVAL=1
KLINE_CACHE_SIZE=100
MAX_SUBSCRIBERS_PER_STOCK=10

# =============================================================================
# 日志配置
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/quantx.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# =============================================================================
# GraphQL 配置
# =============================================================================
GRAPHQL_DEBUG=True
GRAPHQL_INTROSPECTION=True
GRAPHQL_PLAYGROUND=True

# =============================================================================
# Prefect（外部控制面）
# =============================================================================
PREFECT_ENABLED=True
PREFECT_API_URL=http://192.168.101.4:30420/api
PREFECT_WORKER_POOL=quantx-pool

# 离线研究产物只读根目录；留空时使用 ${QUANTX_ROOT}/.runtime/research-runs
QUANTX_RESEARCH_RUNS_ROOT=

# =============================================================================
# 安全配置
# =============================================================================
# 必须使用密码学安全随机值，例如：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 留空时认证接口与 GraphQL 会安全失败关闭。
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256
AUTH_ISSUER=quantx
AUTH_AUDIENCE=quantx-clients
AUTH_WEB_REFRESH_COOKIE_NAME=quantx_refresh
# Web 会话默认同源；生产环境必须使用 HTTPS，开发环境可设置为 False。
AUTH_WEB_COOKIE_SECURE=False
AUTH_WEB_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# 仅 ENV=development 时可用；后端从数据库加载该用户，不向前端发送密码。
AUTH_DEVELOPMENT_AUTO_LOGIN=False
AUTH_DEVELOPMENT_USERNAME=

# 仅首次创建本地用户时填写；创建完成后立即从环境中移除密码。
AUTH_BOOTSTRAP_USERNAME=
AUTH_BOOTSTRAP_PASSWORD=
AUTH_BOOTSTRAP_DISPLAY_NAME=QuantX 用户
# List 类型使用 JSON。资金账号只保留在受控后端环境，禁止提交到仓库。
AUTH_BOOTSTRAP_ACCOUNT_IDS=[]
AUTH_BOOTSTRAP_PERMISSIONS=["portfolio:read","market:read","strategy:read","orders:read","system-status:read","system-config:write","mutation:write","assistant:read","assistant:write"]
AUTH_LOGIN_RATE_LIMIT_ATTEMPTS=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# =============================================================================
# 真实交易与做 T 生产门禁（默认全部关闭）
# =============================================================================
ENABLE_REAL_TRADING=False
T_TRADE_LIVE_ENABLED=False
# 逗号分隔；只有同时通过账户灰度、快照、对账和 Agent READY 门禁才会生效。
REAL_TRADING_ACCOUNT_ALLOWLIST=

# =============================================================================
# 股票数据配置
# =============================================================================
MOCK_DATA_ENABLED=True
PRICE_UPDATE_VARIANCE=0.02
VOLUME_RANGE_MIN=100000
VOLUME_RANGE_MAX=10000000

# =============================================================================
# LLM/AI 服务配置
# =============================================================================
# 产品内 AI Assistant 使用独立 Agents SDK Runtime；无 Key 时保持禁用，
# API、Engine、Worker、QMT Agent 和前端仍可正常使用。
AI_ASSISTANT_ENABLED=True
OPENAI_API_KEY=
QUANTX_AI_MODEL=gpt-5.6
AI_ASSISTANT_MAX_CONCURRENT_RUNS=2
AI_ASSISTANT_MAX_TURNS=12
AI_ASSISTANT_MAX_TOOL_CALLS=8
AI_ASSISTANT_RUN_TIMEOUT_SECONDS=300
AI_ASSISTANT_LEASE_SECONDS=60
AI_ASSISTANT_TRACING_ENABLED=False

# LLM API Key (支持 Gemini、OpenAI 等)
LLM_API_KEY=your-llm-api-key-here
# LLM API URL (例如 Gemini: https://generativelanguage.googleapis.com)
LLM_API_URL=https://generativelanguage.googleapis.com
# LLM 模型名称 (例如 Gemini: gemini-2.0-flash-exp)
LLM_MODEL=gemini-2.0-flash-exp
