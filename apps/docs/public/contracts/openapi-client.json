{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "deviceName": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Devicename"
          },
          "password": {
            "format": "password",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          },
          "username": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "RefreshRequest": {
        "properties": {
          "refreshToken": {
            "format": "password",
            "maxLength": 512,
            "minLength": 32,
            "title": "Refreshtoken",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "refreshToken"
        ],
        "title": "RefreshRequest",
        "type": "object"
      },
      "SessionGrantResponse": {
        "properties": {
          "accessToken": {
            "title": "Accesstoken",
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "title": "Accesstokenexpiresat",
            "type": "string"
          },
          "deviceSessionId": {
            "title": "Devicesessionid",
            "type": "string"
          },
          "refreshToken": {
            "title": "Refreshtoken",
            "type": "string"
          },
          "refreshTokenExpiresAt": {
            "title": "Refreshtokenexpiresat",
            "type": "string"
          },
          "tokenType": {
            "default": "Bearer",
            "title": "Tokentype",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/SessionUserResponse"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "accessTokenExpiresAt",
          "refreshTokenExpiresAt",
          "deviceSessionId",
          "user"
        ],
        "title": "SessionGrantResponse",
        "type": "object"
      },
      "SessionStateResponse": {
        "properties": {
          "accessTokenExpiresAt": {
            "title": "Accesstokenexpiresat",
            "type": "string"
          },
          "deviceSessionId": {
            "title": "Devicesessionid",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/SessionUserResponse"
          }
        },
        "required": [
          "deviceSessionId",
          "accessTokenExpiresAt",
          "user"
        ],
        "title": "SessionStateResponse",
        "type": "object"
      },
      "SessionUserResponse": {
        "properties": {
          "authorizedAccountIds": {
            "items": {
              "type": "string"
            },
            "title": "Authorizedaccountids",
            "type": "array"
          },
          "displayName": {
            "title": "Displayname",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "title": "Permissions",
            "type": "array"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "displayName",
          "permissions",
          "authorizedAccountIds"
        ],
        "title": "SessionUserResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "QuantX 原生客户端会话与服务状态接口。业务查询、变更和订阅使用同源 /graphql。",
    "title": "QuantX Client API",
    "version": "2.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/session": {
      "delete": {
        "operationId": "delete_session_auth_session_delete",
        "parameters": [
          {
            "in": "query",
            "name": "allDevices",
            "required": false,
            "schema": {
              "default": false,
              "title": "Alldevices",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Session",
        "tags": [
          "authentication"
        ]
      },
      "get": {
        "operationId": "get_session_auth_session_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionStateResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Session",
        "tags": [
          "authentication"
        ]
      },
      "post": {
        "operationId": "create_session_auth_session_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionGrantResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Session",
        "tags": [
          "authentication"
        ]
      }
    },
    "/auth/session/refresh": {
      "post": {
        "operationId": "refresh_session_auth_session_refresh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionGrantResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Refresh Session",
        "tags": [
          "authentication"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Check"
      }
    },
    "/health/components": {
      "get": {
        "operationId": "health_components_health_components_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Components"
      }
    },
    "/health/live": {
      "get": {
        "operationId": "health_live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Live"
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "health_ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Ready"
      }
    }
  }
}
