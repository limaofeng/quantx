#include "Base.xcconfig"

QUANTX_ENVIRONMENT = staging
QUANTX_GRAPHQL_HTTP_URL = https:$(URL_SEPARATOR)$(URL_SEPARATOR)staging.quantx.invalid/graphql
QUANTX_GRAPHQL_WEBSOCKET_URL = wss:$(URL_SEPARATOR)$(URL_SEPARATOR)staging.quantx.invalid/graphql
QUANTX_HEALTH_URL = https:$(URL_SEPARATOR)$(URL_SEPARATOR)staging.quantx.invalid/health
QUANTX_AUTH_BASE_URL = https:$(URL_SEPARATOR)$(URL_SEPARATOR)staging.quantx.invalid

DEBUG_HTTP_ALLOWED = 0
QUANTX_ACCOUNT_DATA_ENABLED = NO
QUANTX_LOG_LEVEL = info

// Optional machine-local endpoint and signing overrides. This file is ignored by Git.
#include? "Staging.local.xcconfig"
