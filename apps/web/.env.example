# QuantX 环境变量配置示例
# 复制此文件为 .env.local 并根据实际情况修改

# ===========================================
# 基础配置
# ===========================================
VITE_APP_TITLE=QuantX
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=dev
# 唯一交易账户；页面不提供账户切换
VITE_DEFAULT_ACCOUNT_ID=your_account_id
# 仅 Vite development 模式尝试后端开发自动会话；生产构建始终忽略。
VITE_AUTH_DEVELOPMENT_AUTO_LOGIN=false

# ===========================================
# API 配置
# ===========================================
# Web 使用同源 /auth 与 /graphql；开发服务器通过此地址代理到后端。
VITE_PROXY_TARGET=http://127.0.0.1:8080
VITE_GRAPHQL_HTTP_URL=/graphql
# 留空时自动从当前页面地址推导同源 WebSocket。
VITE_GRAPHQL_WS_URL=

# ===========================================
# 功能开关
# ===========================================
VITE_ENABLE_DEBUG=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=false
VITE_ENABLE_PERFORMANCE_MONITORING=true

# ===========================================
# Mock 配置 (MSW GraphQL Mock)
# ===========================================
# 启用/禁用 Mock 系统
VITE_MOCK_ENABLED=false
# 默认 Mock 的 GraphQL 查询（逗号分隔）
VITE_MOCK_DEFAULT_QUERIES=portfolioSummary,GetCurrentAccount
# Mock 响应延迟（毫秒）
VITE_MOCK_DELAY=500
# 显示 Mock 详细日志
VITE_MOCK_VERBOSE=true

# ===========================================
# 性能预算 (KB)
# ===========================================
VITE_PERFORMANCE_BUDGET_JS=500
VITE_PERFORMANCE_BUDGET_CSS=100
VITE_PERFORMANCE_BUDGET_ASSETS=2000

# ===========================================
# 外部服务 (可选)
# ===========================================
# VITE_SENTRY_DSN=
# VITE_GOOGLE_ANALYTICS_ID=

# ===========================================
# 开发配置
# ===========================================
VITE_HMR_PORT=24678
# VITE_PROXY_TARGET=http://192.168.5.6:8080
