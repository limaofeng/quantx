# QuantX 环境变量配置示例
# 复制此文件为 .env.local 并根据实际情况修改

# ===========================================
# 基础配置
# ===========================================
VITE_APP_TITLE=QuantX
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=dev

# ===========================================
# API 配置
# ===========================================
VITE_API_URL=http://192.168.5.6:8080
VITE_GRAPHQL_URL=http://192.168.5.6:8080/graphql
VITE_WS_URL=ws://192.168.5.6:8080/graphql

# ===========================================
# 功能开关
# ===========================================
VITE_ENABLE_DEBUG=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=false
VITE_ENABLE_PERFORMANCE_MONITORING=true

# ===========================================
# Mock 配置 (MSW GraphQL Mock)
# ===========================================
# 启用/禁用 Mock 系统
VITE_MOCK_ENABLED=false
# 默认 Mock 的 GraphQL 查询（逗号分隔）
VITE_MOCK_DEFAULT_QUERIES=portfolioSummary,GetCurrentAccount
# Mock 响应延迟（毫秒）
VITE_MOCK_DELAY=500
# 显示 Mock 详细日志
VITE_MOCK_VERBOSE=true

# ===========================================
# 性能预算 (KB)
# ===========================================
VITE_PERFORMANCE_BUDGET_JS=500
VITE_PERFORMANCE_BUDGET_CSS=100
VITE_PERFORMANCE_BUDGET_ASSETS=2000

# ===========================================
# 外部服务 (可选)
# ===========================================
# VITE_SENTRY_DSN=
# VITE_GOOGLE_ANALYTICS_ID=

# ===========================================
# 开发配置
# ===========================================
VITE_HMR_PORT=24678
# VITE_PROXY_TARGET=http://192.168.5.6:8080