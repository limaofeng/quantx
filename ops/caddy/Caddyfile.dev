{
	admin 127.0.0.1:2019
	auto_https disable_redirects
}

(tls_disabled) {
}

(tls_internal) {
	tls internal
}

{$QUANTX_CADDY_SITE_ADDRESS:http://:8080} {
	bind {$QUANTX_CADDY_BIND:0.0.0.0}
	import {$QUANTX_CADDY_TLS_SNIPPET:tls_disabled}

	@trusted remote_ip {$QUANTX_CADDY_TRUSTED_IPS:0.0.0.0/0}
	handle @trusted {
		route {
			@docs_root path /docs
			redir @docs_root /docs/ 308

			@market_data_internal path /market-data/internal/v1/* /agent/market-data/* /market-data/v1/history /market-data/v1/history/* /market-data/v1/reference/* /market-data/v1/calendar/*
			reverse_proxy @market_data_internal 127.0.0.1:18085

			@market_gateway path /ws/agent/market /market-data/v1/stream
			reverse_proxy @market_gateway 127.0.0.1:18082

			@private_observation path /monitor/internal/* /internal/monitor/*
			respond @private_observation "Not Found" 404

			@monitor path /monitor/*
			reverse_proxy @monitor 127.0.0.1:18083

			@api path /runtime/environment /graphql* /auth* /health* /metrics* /ws/agent* /agent/* /market-data-sync/*
			reverse_proxy @api 127.0.0.1:18081

			@docs path /docs/*
			reverse_proxy @docs 127.0.0.1:5251

			# Only the Web frontend reaches this handler. Keep API responses and
			# streaming connections outside static-resource compression.
			encode {
				gzip 1
				minimum_length 1024
				match {
					header Content-Type text/html*
					header Content-Type text/javascript*
					header Content-Type application/javascript*
					header Content-Type text/css*
					header Content-Type application/json*
					header Content-Type image/svg+xml*
				}
			}

			reverse_proxy 127.0.0.1:5250
		}
	}

	respond "Forbidden" 403
}
