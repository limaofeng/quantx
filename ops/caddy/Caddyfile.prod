{
	admin off
}

https://127.0.0.1:8080 {
	bind 127.0.0.1
	tls internal
	route {
		@docs_root path /docs
		redir @docs_root /docs/ 308

		@market_data_service path /ws/agent/market
		reverse_proxy @market_data_service 127.0.0.1:18082

		@monitor path /monitor/*
		reverse_proxy @monitor 127.0.0.1:18083

		@api path /graphql* /auth* /health* /metrics* /ws/agent* /agent/*
		reverse_proxy @api 127.0.0.1:18081

		handle_path /docs/* {
			root * {$QUANTX_ROOT}/apps/docs/dist
			try_files {path} {path}.html {path}/index.html /404.html
			file_server
		}

		handle {
			root * {$QUANTX_ROOT}/apps/web/dist
			try_files {path} /index.html
			file_server
		}
	}
}
