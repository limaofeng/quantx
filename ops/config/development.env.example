# Copy to apps/api/.env.development on macOS; keep credentials local.
ENV=development
CONDA_ENV_NAME=quantx
DATABASE_URL=postgresql+asyncpg://quantx_dev:CHANGE_ME@127.0.0.1:5432/quantx_dev
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_HOST=127.0.0.1
INFLUXDB_HOST=http://127.0.0.1:8181
INFLUXDB_DATABASE=quantx_dev
INFLUXDB_TOKEN=CHANGE_ME
PREFECT_API_URL=http://127.0.0.1:4200/api
PREFECT_WORKER_POOL=quantx-dev-pool
PUBLIC_URL=http://127.0.0.1:8080
ENABLE_REAL_TRADING=false
QMT_REAL_TRADING_ENABLED=false
T_TRADE_LIVE_ENABLED=false
REAL_TRADING_ACCOUNT_ALLOWLIST=[]
QMT_ACCOUNT_WHITELIST=
QMT_AGENT_MODE=paper
QUANTX_MARKET_DATA_URL=http://192.168.5.6:8080
QUANTX_MARKET_DATA_TOKEN=CHANGE_ME_TO_THE_WINDOWS_MARKET_ONLY_TOKEN
QUANTX_MARKET_DATA_INSTRUMENTS=600000.SH
AUTH_BOOTSTRAP_ACCOUNT_IDS=["paper-local"]
SECRET_KEY=CHANGE_ME_TO_A_DEVELOPMENT_ONLY_RANDOM_SECRET
GRAPHQL_DEBUG=true
