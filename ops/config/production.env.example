# Copy to apps/api/.env.production. Fill existing service addresses and secrets.
ENV=production
CONDA_ENV_NAME=quantx
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
REDIS_URL=redis://HOST:PORT/0
INFLUXDB_HOST=http://HOST:PORT
INFLUXDB_DATABASE=DATABASE
INFLUXDB_TOKEN=CHANGE_ME
PREFECT_API_URL=http://192.168.5.6:30420/api
PREFECT_WORKER_POOL=quantx-pool
PUBLIC_URL=http://192.168.5.6:8080
QUANTX_AGENT_API_URL=http://192.168.5.6:8080
# Explicitly enable only when preparing the authorized production cutover.
ENABLE_REAL_TRADING=false
QMT_REAL_TRADING_ENABLED=false
T_TRADE_LIVE_ENABLED=false
REAL_TRADING_ACCOUNT_ALLOWLIST=[]
QMT_ACCOUNT_WHITELIST=
QMT_AGENT_MODE=live
QUANTX_MARKET_DATA_TOKEN=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
QUANTX_CADDY_TRUSTED_IPS=127.0.0.1/32 192.168.5.0/24
SECRET_KEY=CHANGE_ME_TO_THE_EXISTING_PRODUCTION_SECRET
DEBUG=false
GRAPHQL_DEBUG=false
