# Copy to apps/api/.env.production. Never commit populated secrets.
ENV=production
HOST=127.0.0.1
PORT=18081
PUBLIC_URL=https://127.0.0.1:8080

DEBUG=false
GRAPHQL_DEBUG=false
GRAPHQL_INTROSPECTION=false
GRAPHQL_PLAYGROUND=false
MOCK_DATA_ENABLED=false
AUTH_WEB_COOKIE_SECURE=true
CORS_ORIGINS=https://127.0.0.1:8080
AUTH_WEB_ALLOWED_ORIGINS=https://127.0.0.1:8080

SECRET_KEY=
DATABASE_URL=
REDIS_URL=
INFLUXDB_HOST=
INFLUXDB_DATABASE=
INFLUXDB_USERNAME=
INFLUXDB_PASSWORD=

ENABLE_REAL_TRADING=false
QMT_REAL_TRADING_ENABLED=false
T_TRADE_LIVE_ENABLED=false
REAL_TRADING_ACCOUNT_ALLOWLIST=
QMT_USERDATA_PATH=
MONITOR_QMT_AGENT_HEALTH_URL=http://windows-qmt-host:18084
