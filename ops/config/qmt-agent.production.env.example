# Copy to .runtime/qmt-agent/.env.production on the Windows QMT execution node.
# The device credential itself remains in Windows Credential Manager.
# QUANTX_QMT_PYTHON_EXE=C:\Users\you\miniconda3\envs\xtquant-demo\python.exe
QMT_ACCOUNT_WHITELIST=
ENABLE_REAL_TRADING=true
QMT_REAL_TRADING_ENABLED=true
QMT_USERDATA_PATH=
QMT_AGENT_HEALTH_HOST=0.0.0.0
QMT_AGENT_HEALTH_PORT=18084
