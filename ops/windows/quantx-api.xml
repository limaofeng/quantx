<service>
  <id>QuantXApi</id>
  <name>QuantX API</name>
  <description>QuantX FastAPI, GraphQL and QMT Agent WebSocket hub.</description>
  <executable>{{PYTHON}}</executable>
  <arguments>-m uvicorn quantx_api.main:app --host 127.0.0.1 --port 18081 --ws-ping-interval 20 --ws-ping-timeout 960</arguments>
  <workingdirectory>{{ROOT}}</workingdirectory>
  <env name="ENV" value="production" />
  <env name="RUNTIME_PROFILE" value="full" />
  <env name="PREFECT_ENABLED" value="true" />
  <env name="PREFECT_API_URL" value="{{PREFECT_API_URL}}" />
  <env name="PREFECT_WORKER_POOL" value="{{PREFECT_WORKER_POOL}}" />
  <env name="QUANTX_ROOT" value="{{ROOT}}" />
  <env name="QUANTX_RUNTIME_DIR" value="{{RUNTIME}}" />
  <env name="QUANTX_ENV_FILE" value="{{RUNTIME}}\config\.env.production" />
  <env name="LOG_FILE" value="{{RUNTIME}}\logs\quantx-api.log" />
  <env name="PYTHONUTF8" value="1" />
  <env name="PYTHONIOENCODING" value="utf-8" />
  <env name="PYTHONPATH" value="{{PYTHONPATH}}" />
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>45 sec</stoptimeout>
  <logpath>{{RUNTIME}}\logs\services\api</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>10</keepFiles>
  </log>
</service>
