<service>
  <id>QuantXEngine</id>
  <name>QuantX Engine</name>
  <description>QuantX single-instance strategy and order convergence engine.</description>
  <executable>{{PYTHON}}</executable>
  <arguments>-m quantx_engine.main</arguments>
  <workingdirectory>{{ROOT}}</workingdirectory>
  <env name="ENV" value="production" />
  <env name="DATABASE_PROCESS_ROLE" value="engine" />
  <env name="QUANTX_ROOT" value="{{ROOT}}" />
  <env name="QUANTX_ENV_FILE" value="{{RUNTIME}}\config\.env.production" />
  <env name="PYTHONUTF8" value="1" />
  <env name="PYTHONIOENCODING" value="utf-8" />
  <env name="PYTHONPATH" value="{{PYTHONPATH}}" />
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>60 sec</stoptimeout>
  <logpath>{{RUNTIME}}\logs\services\engine</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>10</keepFiles>
  </log>
</service>
