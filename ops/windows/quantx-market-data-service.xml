<service>
  <id>QuantXMarketDataService</id>
  <name>QuantX Market Data Service</name>
  <description>Dedicated QMT whole-market WebSocket and Redis convergence service.</description>
  <executable>{{PYTHON}}</executable>
  <arguments>"{{ROOT}}\ops\supervise_process.py" --name market-data-service --state-dir "{{RUNTIME}}\state" -- "{{PYTHON}}" -m uvicorn quantx_api.market_data_service:app --host 127.0.0.1 --port 18082 --ws-max-size 67108864 --ws-ping-interval 20 --ws-ping-timeout 960</arguments>
  <workingdirectory>{{ROOT}}</workingdirectory>
  <env name="ENV" value="production" />
  <env name="DATABASE_PROCESS_ROLE" value="market-data-service" />
  <env name="QUANTX_ROOT" value="{{ROOT}}" />
  <env name="QUANTX_RUNTIME_DIR" value="{{RUNTIME}}" />
  <env name="QUANTX_ENV_FILE" value="{{RUNTIME}}\config\.env.production" />
  <env name="LOG_FILE" value="{{RUNTIME}}\logs\quantx-market-data-service.log" />
  <env name="PYTHONUTF8" value="1" />
  <env name="PYTHONIOENCODING" value="utf-8" />
  <env name="PYTHONPATH" value="{{PYTHONPATH}}" />
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="1 sec" />
  <onfailure action="restart" delay="5 sec" />
  <onfailure action="restart" delay="30 sec" />
  <resetfailure>5 minutes</resetfailure>
  <stoptimeout>45 sec</stoptimeout>
  <logpath>{{RUNTIME}}\logs\services\market-data-service</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>10</keepFiles>
  </log>
</service>
