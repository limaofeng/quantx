<service>
  <id>QuantXMonitor</id>
  <name>QuantX Monitor</name>
  <description>Independent QuantX availability, latency, and incident history service.</description>
  <executable>{{PYTHON}}</executable>
  <arguments>-m quantx_monitor.main</arguments>
  <workingdirectory>{{ROOT}}</workingdirectory>
  <env name="ENV" value="production" />
  <env name="QUANTX_ROOT" value="{{ROOT}}" />
  <env name="QUANTX_ENV_FILE" value="{{RUNTIME}}\config\.env.production" />
  <env name="MONITOR_DATABASE_PATH" value="{{RUNTIME}}\monitor\quantx-monitor.sqlite3" />
  <env name="PYTHONUTF8" value="1" />
  <env name="PYTHONIOENCODING" value="utf-8" />
  <env name="PYTHONPATH" value="{{PYTHONPATH}}" />
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>60 sec</stoptimeout>
  <logpath>{{RUNTIME}}\logs\services\monitor</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>10</keepFiles>
  </log>
</service>
