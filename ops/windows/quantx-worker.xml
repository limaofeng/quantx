<service>
  <id>QuantXWorker</id>
  <name>QuantX Prefect Worker</name>
  <description>QuantX Prefect process worker.</description>
  <executable>{{PYTHON}}</executable>
  <arguments>-m prefect worker start --pool {{PREFECT_WORKER_POOL}} --type process</arguments>
  <workingdirectory>{{ROOT}}</workingdirectory>
  <env name="PREFECT_API_URL" value="{{PREFECT_API_URL}}" />
  <env name="DATABASE_PROCESS_ROLE" value="worker" />
  <env name="PREFECT_WORKER_POOL" value="{{PREFECT_WORKER_POOL}}" />
  <env name="PREFECT_HOME" value="{{RUNTIME}}\prefect" />
  <env name="PYTHONUTF8" value="1" />
  <env name="PYTHONIOENCODING" value="utf-8" />
  <env name="QUANTX_ROOT" value="{{ROOT}}" />
  <env name="QUANTX_ENV_FILE" value="{{RUNTIME}}\config\.env.production" />
  <env name="PYTHONPATH" value="{{PYTHONPATH}}" />
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>60 sec</stoptimeout>
  <logpath>{{RUNTIME}}\logs\services\worker</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>10</keepFiles>
  </log>
</service>
